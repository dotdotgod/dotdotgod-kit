[
  {
    "name": "execute",
    "description": "Run 1..100 labeled local commands with bounded concurrency. Group independent known commands; separate commands dependent on earlier results. Inspect every results entry status and indexed.id. Do not bypass permissions or safety gates.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "shell": {
                "type": "boolean"
              },
              "cwd": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "outputLimit": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "directLimit": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "outputMode": {
                "type": "string",
                "enum": [
                  "auto",
                  "direct",
                  "indexed",
                  "discard"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "transient",
                  "session",
                  "project"
                ]
              },
              "ttlMs": {
                "type": "integer",
                "minimum": 0
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "environmentMode": {
                "type": "string",
                "enum": [
                  "inherit-filtered-v1",
                  "allowlist-v1"
                ]
              },
              "allowedEnv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 100
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "cwd": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
