{
  "name": "@dotdotgod/hermes",
  "version": "0.6.0",
  "description": "Hermes CLI and messaging-gateway adapter without Plan Mode.",
  "type": "module",
  "publishConfig": { "access": "public" },
  "license": "Elastic-2.0",
  "engines": { "node": ">=22.19.0" },
  "devDependencies": { "@dotdotgod/context": "workspace:*", "@modelcontextprotocol/sdk": "^1.25.2", "esbuild": "0.27.3" },
  "scripts": {
    "build:runtime": "node ../../scripts/build-adapter-runtime.mjs hermes",
    "test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -v -s test -p 'test_*.py' && node --test test/*.test.mjs",
    "verify": "node ../../scripts/build-adapter-runtime.mjs hermes --check && pnpm run test",
    "pack:dry-run": "pnpm pack --dry-run --json"
  },
  "files": ["plugin.yaml", "__init__.py", "runtime.py", "proxy.py", "policy.py", "mcp", "skills", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/dotdotgod/dotdotgod-kit.git", "directory": "packages/hermes" }
}
