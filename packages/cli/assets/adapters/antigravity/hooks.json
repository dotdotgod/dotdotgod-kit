{
  "dotdotgod": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|call_mcp_tool|mcp__dotdotgod_context__.*|dotdotgod_context__.*|mcp__dotdotgod-context__.*",
        "hooks": [
          {
            "type": "command",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "timeout": 25
      }
    ]
  }
}
