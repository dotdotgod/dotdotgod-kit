      {
        "id": "docs",
        "label": "Project Documentation",
        "paths": [
          "docs/**"
        ],
        "excludePaths": [],
        "scope": "shared",
        "freshness": "fresh",
        "role": "project-documentation",
        "priority": 60,
        "includeBodiesByDefault": true
