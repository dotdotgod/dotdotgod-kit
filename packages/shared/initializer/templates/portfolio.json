  },
  "traceability": {
    "required": [
      "docs/strategy/**",
      "docs/positions/**"
    ],
    "exclude": [
      "**/README.md"
    ],
    "keys": [
      {
        "key": "supportedBy",
        "label": "Supported by",
        "description": "Data or research supporting the investment conclusion.",
        "target": "path",
        "relation": "supported_by",
        "weight": 4
      },
      {
        "key": "recordedIn",
        "label": "Recorded in",
        "description": "Ledgers, snapshots, or journals recording the decision.",
        "target": "path",
        "relation": "recorded_in",
        "weight": 4
      },
      {
        "key": "informs",
        "label": "Informs",
        "description": "Strategies, theses, or risk rules using this conclusion.",
        "target": "path",
        "relation": "informs_decision",
        "weight": 3
      }
    ]
  },
  "validation": {
    "markdown": {
      "maxLines": 200,
      "maxChars": 10000,
      "exclude": [],
      "filename": {
        "warnNumberedSeries": true,
        "allow": []
      }
    }
  },
  "impactRanking": {
    "semantic": {
      "enabled": true,
      "threshold": 0.5,
      "topKPerFile": 5
    }
  },
  "referenceExpansion": {
    "fuzzy": {
      "lowSignal": {
        "add": [],
        "remove": []
      }
    }
  },
  "load": {
    "pinnedPaths": [],
    "pinnedBodies": [],
    "documentationSummary": {
      "exclude": [
        "docs/plan",
        "docs/archive"
      ]
    }
  },
  "planMode": {
    "writablePaths": [
      "docs/plan/**",
      "docs/archive/**"
    ]
  }
}
