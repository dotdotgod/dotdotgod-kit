  "traceability": {
    "required": [
      "docs/spec/**",
      "docs/report/**"
    ],
    "exclude": [
      "**/README.md"
    ],
    "keys": [
      {
        "key": "informedBy",
        "label": "Informed by",
        "description": "Research sources or prior findings that justify the direction.",
        "target": "path",
        "relation": "informed_by",
        "weight": 4
      },
      {
        "key": "assumptionsDefinedIn",
        "label": "Assumptions defined in",
        "description": "Documents defining assumptions that bound the claim.",
        "target": "path",
        "relation": "assumptions_defined_in",
        "weight": 4
      },
      {
        "key": "evaluatedBy",
        "label": "Evaluated by",
        "description": "Evaluation protocols or measurement methods.",
        "target": "path",
        "relation": "evaluated_by",
        "weight": 4
      },
      {
        "key": "evidenceRecordedIn",
        "label": "Evidence recorded in",
        "description": "Dated experiment, dataset, or validation records.",
        "target": "path",
        "relation": "evidence_recorded_in",
        "weight": 4
      }
    ]
  },
  "validation": {
    "markdown": {
      "maxLines": 200,
      "maxChars": 10000,
      "exclude": [],
      "filename": {
        "warnNumberedSeries": true,
        "allow": []
      }
    }
  },
  "impactRanking": {
    "semantic": {
      "enabled": true,
      "threshold": 0.5,
      "topKPerFile": 5
    }
  },
  "referenceExpansion": {
    "fuzzy": {
      "lowSignal": {
        "add": [],
        "remove": []
      }
    }
  },
  "load": {
    "pinnedPaths": [],
    "pinnedBodies": [],
    "documentationSummary": {
      "exclude": [
        "docs/plan",
        "docs/archive"
      ]
    }
  },
  "planMode": {
    "writablePaths": [
      "docs/plan/**",
      "docs/archive/**"
    ]
  }
}
